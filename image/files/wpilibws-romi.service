[Unit]
Description=WPILib WebSocket server for the Romi (wpilibws-romi)
After=network.target

[Service]
User=pi
Group=pi
SupplementaryGroups=i2c
WorkingDirectory=/home/pi
ExecStart=/usr/bin/node /opt/wpilibws-romi/node_modules/@wpilib/wpilib-ws-robot-romi/dist/index.js -c /etc/romi/romi.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
